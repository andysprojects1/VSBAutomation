# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
REVIEW_CHANNEL_ID=
ADMIN_CHANNEL_ID=
SCRAPER_LOG_CHANNEL_ID=
AUTO_REGISTER_COMMANDS=true

# Storage. Railway Postgres will usually provide DATABASE_URL.
DATABASE_URL=
STORE_DRIVER=postgres

# eBay Marketplace Insights sold comps.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_IDS=15687,155183
EBAY_USE_SANDBOX=false
EBAY_ENABLE_ACTIVE_FALLBACK=false

# Vision provider: heuristic, openai, or webhook.
VISION_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VISION_WEBHOOK_URL=
VISION_WEBHOOK_TOKEN=

# App behavior
PORT=3000
MAX_COMPS_PER_QUERY=15
MAX_VISION_COMPARISONS=5
PUBLIC_BASE_URL=
